# Zion Terminal Configuration
# Copy this to .env and fill in your values.
# All keys are OPTIONAL — the system works without any of them.

# ── LLM Provider ─────────────────────────────────────────────────
# Options: none (default), openai, ollama
LLM_PROVIDER=none

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── Data Sources ─────────────────────────────────────────────────
# Yahoo Finance: no key required (free, unofficial API)

# FRED: free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR: identity string required by SEC policy (e.g. "Your Name your@email.com")
EDGAR_IDENTITY=

# ── Cache ────────────────────────────────────────────────────────
CACHE_DIR=.cache/zion
CACHE_TTL_SECONDS=3600

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=WARNING
