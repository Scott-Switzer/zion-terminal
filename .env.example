# Zion Terminal Environment Configuration
# Copy this file to .env and fill in your API keys

# ─── LLM Provider ────────────────────────────────────────────────
# OpenAI-compatible API key for LLM-powered agents (orchestrator, synthesis, validation)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── Data Source API Keys ────────────────────────────────────────
# FRED (Federal Reserve Economic Data) - free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key-here

# Alpha Vantage (equities) - free at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here

# Polygon.io (equities) - free tier at https://polygon.io/
POLYGON_API_KEY=your-polygon-key-here

# ─── SEC EDGAR ───────────────────────────────────────────────────
# Required by SEC: your name and email for User-Agent header
EDGAR_IDENTITY="Your Name your.email@example.com"

# ─── Cache Settings ──────────────────────────────────────────────
CACHE_DIR=.cache
CACHE_TTL_SECONDS=3600

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
