{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "zion-financial-serving-v2-thin-staging",
  "main": "../src/thin_worker.py",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "python_workers",
    "disable_python_external_sdk"
  ],
  "workers_dev": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "r2_buckets": [
    {
      "binding": "MARKET_DATA",
      "bucket_name": "financial-system-datasets"
    },
    {
      "binding": "SEC_CORPUS",
      "bucket_name": "ppe-sec-intelligence-prod"
    },
    {
      "binding": "SEC_ARCHIVE",
      "bucket_name": "financial-data-wrds-private"
    }
  ],
  "vars": {
    "BUNDLE_SHARED_SNAPSHOT": "true",
    "SERVING_V2_ENABLED": "true",
    "SERVING_V2_CURRENT_KEY": "gold/serving/coverage25/CURRENT.json",
    "CURRENT_POINTER_CACHE_TTL_MS": "0",
    "DIAGNOSTIC_ISOLATE_TELEMETRY": "true",
    "SERVICE_VERSION": "3.1.0-zion-financial-data-api-v1",
    "SYNTHETIC_WORLD_ID": "system-acceptance-v2",
    "SYNTHETIC_WORLD_IDS": "system-acceptance-v2",
    "SYNTHETIC_CURRENT_KEY": "control/synthetic-worlds/system-acceptance-v2/CURRENT.json",
    "SEC_EXPANDED_INDEX_KEY": "gold/sec-expanded/releases/66c116df4860e40b560c3f38cdafba37acae6ae77a7387fc144bb829f3257da0/manifest.json",
    "SEC_EXPANDED_INDEX_SHA256": "d7d93516a7a2cc18859b749fbb3a5719bc92406452ede3505bfde6536fa3f556",
    "SEC_HISTORY_MANIFEST_KEY": "gold/sec-financial-history/releases/b2b25814a374cfdc2dfd0a6283b8eaf2c430b24778a2afe94de8c0562be446f4/manifest.json",
    "SEC_HISTORY_MANIFEST_SHA256": "37d334e20830a43905b7fd39762946e7986004e82df19cd90ca0cbf866b922f8",
    "SEC_ENGINE_MANIFEST_KEY": "gold/sec-engine/releases/b39a670bad0670449256e59d38bf6b9600503449baded29c25e41d5fb368c6bb/manifest.json",
    "SEC_ENGINE_MANIFEST_SHA256": "4e0d6b9eac28ea2352dd255c4f8323f1fd4d486796063921cec691942660be7b",
    "SEC_ENGINE_ENABLED": "true",
    "SEC_READINESS_INDEX_KEY": "gold/sec-readiness/index/87f6bb816976417c89d6047386dc6696c18305212fb4aee4200c350f7c986d67/manifest.json",
    "SEC_READINESS_INDEX_SHA256": "9c5c548b9c9cba3dd12a9604143656d25f27831a689550fa2d1a16250f5a953b",
    "SEC_COMPANYFACTS_MANIFEST_KEY": "gold/sec-companyfacts/releases/f4f81944fbf79e2cac8b119b457fd8e45b92f2171e783ecd36f85b18df80b25b/manifest.json",
    "SEC_COMPANYFACTS_MANIFEST_SHA256": "032d432d6a0478c146ce9c1a62c0565f9a2e725826ce3a2ed323c395b6ff850f",
    "UNIFIED_RESEARCH_MANIFEST_KEY": "gold/unified-research/releases/358ea45de35af6003347dc163fe31eebd09988d1b3715c3386e5ab8c0dfee72e/manifest.json",
    "UNIFIED_RESEARCH_MANIFEST_SHA256": "de3957597bb0575d845b47edb3495f4018918be6c6136fd14d9bef827579c344",
    "OWNER_ONLY_MARKET_DATA": "true"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "services": [
    {
      "binding": "PRIVATE_DATASETS",
      "service": "zion-datasets"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SEC_ENGINE_QUEUE",
        "queue": "zion-sec-engine-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "zion-sec-engine-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  },
  "limits": {
    "cpu_ms": 30000
  }
}
